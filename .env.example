# ============================================================
# Chinese Signal Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── MongoDB Atlas (REQUIRED for permanent storage) ────────────
# Without this, data will reset when server restarts!
# Free forever: https://www.mongodb.com/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/csbot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/csbot?retryWrites=true&w=majority

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Telegram (optional, already hardcoded in server.js) ──────
# Uncomment to override the hardcoded values
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# ── Optional: custom data directory (file-mode only) ─────────
# Only used when MONGODB_URI is NOT set
# On Render: set DATA_DIR=/data and mount a persistent disk at /data
# DATA_DIR=/data
