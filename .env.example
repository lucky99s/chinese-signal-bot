# ═══════════════════════════════════════════════════════════
# Chinese Signal Bot — Server v6 Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values before deploying.

# ── MongoDB ────────────────────────────────────────────────
# Required for permanent storage. Without it, server falls back to file storage.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/csbot?retryWrites=true&w=majority

# ── Telegram Bot ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8881942924:AAHbrAuMs6oGTDbivfRBUNYUlSgsviCO5Qc
TELEGRAM_CHAT_ID=7293402395

# ── Telegram Channel Access Gate ─────────────────────────
# Users must join this channel before they can use the bot via /start.
# ⚠️  IMPORTANT: Add your bot as an ADMIN of the channel — without that,
# getChatMember cannot verify membership and the check will be bypassed.
REQUIRED_CHANNEL=@A_ToolsX

# ── Bot URL (shown to verified users after /start) ────────
# Set this to your main-bot.html URL so members get a clickable link.
BOT_URL=https://your-server-url.onrender.com/main-bot.html

# ── Auto-OTP via Gmail IMAP ───────────────────────────────
# The bot watches this inbox for OTP emails from Quotex and
# automatically fills the OTP into the browser — no manual copy-paste.
#
# STEP 1: Use the Gmail address that RECEIVES Quotex OTP emails.
# STEP 2: Gmail → Settings → Forwarding and POP/IMAP → Enable IMAP → Save
# STEP 3: myaccount.google.com → Security → 2-Step Verification
#          → App Passwords → create a password for "Mail / Other"
# STEP 4: Paste that 16-character app password below (NOT your Gmail password)
#
# After setting these two values, run:  npm install imapflow
# Then restart the server — Auto-OTP enables automatically.
#
OTP_EMAIL=your-gmail@gmail.com
OTP_EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional — defaults to Gmail IMAP. Change for Outlook/Yahoo/custom:
# OTP_IMAP_HOST=imap.gmail.com
# OTP_IMAP_PORT=993

# ── Quotex Auto-Login ─────────────────────────────────────
# Set to 'true' to automatically start a Puppeteer login session
# every time a client submits their Quotex credentials on the main bot.
# Requires puppeteer:  npm install puppeteer
AUTO_LAUNCH_ON_LOGIN=true

# ── Server ────────────────────────────────────────────────
PORT=3000

# ── Auto-Retry ────────────────────────────────────────────
AUTO_RETRY_ENABLED=false          # Auto-retry failed Puppeteer sessions
AUTO_RETRY_MAX_ATTEMPTS=3         # Max retries per failed session
AUTO_RETRY_DELAY_SECONDS=30       # Seconds between retry attempts
