# ============================================================
# Chinese Signal Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── PostgreSQL (REQUIRED for permanent storage) ──────────────
# Without this, data will reset when server restarts!
# Free options: Neon (neon.tech), Supabase, Railway, Render
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Optional: custom data directory (file-mode only) ─────────
# Only used when DATABASE_URL is NOT set
# On Render: set DATA_DIR=/data and mount a persistent disk at /data
# DATA_DIR=/data
