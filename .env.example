# ════════════════════════════════════════════════════
#  Chinese Signal Bot v5 — Environment Variables
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════

# MongoDB Atlas connection string (required for permanent storage)
# Without this, the server falls back to file-based storage in ./data/
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/csbot?retryWrites=true&w=majority

# Telegram bot notification settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Server port (optional — defaults to 3000)
PORT=3000

# Directory for file-based fallback storage (optional — defaults to ./data)
DATA_DIR=./data
